            "url": {
              "raw": "http://localhost:8081/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123\",\n  \"city\": \"Bangalore\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
